<%= form_with(model: student, class: "needs-validation") do |form| %>
  <% if student.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <h4 class="alert-heading"><%= pluralize(student.errors.count, "error") %> prohibited this student from being saved:</h4>
      <ul>
        <% student.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label fw-bold" %>
    <%= form.text_field :name, class: "form-control shadow-sm" %>
  </div>

  <div class="mb-3">
    <%= form.label :year_level, "Year level", class: "form-label fw-bold" %>
    <%= form.number_field :year_level, class: "form-control shadow-sm" %>
  </div>

  <div class="mb-3">
    <%= form.label :program, class: "form-label fw-bold" %>
    <%= form.text_field :program, class: "form-control shadow-sm" %>
  </div>

  <div class="mb-3">
    <%= form.label :department_id, class: "form-label fw-bold" %>
    <%= form.collection_select :department_id, Department.all, :id, :name, { prompt: "Select a department" }, { class: "form-select shadow-sm" } %>
  </div>

  <div class="d-flex align-items-center mt-4">
    <%= form.submit class: "btn btn-info text-white rounded-pill px-4 shadow-sm" %>
    <%= link_to "✕ Back to students", students_path, class: "btn btn-outline-danger rounded-pill px-4 ms-2" %>
  </div>
<% end %>
