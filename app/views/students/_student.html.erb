<div id="<%= dom_id student %>">
  <div>
    <strong>Name:</strong>
    <%= student.name %>
  </div>

  <div>
    <strong>Year level:</strong>
    <%= student.year_level %>
  </div>

  <div>
    <strong>Program:</strong>
    <%= student.program %>
  </div>

  <div>
    <strong>Department:</strong>
    <%= student.department&.name %>
  </div>

  <div>
    <strong>Tuition Fee:</strong>
    <%= student.tuitionFee %>
  </div>

  <div>
    <strong>Subjects Count:</strong>
    <%= student.subjectsCount%>
  </div>

  <div>
    <strong>Number of Units:</strong>
    <%= student.numberOfUnits%>
  </div>

</div>
