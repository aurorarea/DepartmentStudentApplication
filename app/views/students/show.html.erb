<p style="color: green"><%= notice %></p>

<%= render @student %>

<% if @student.sections.any? %>
  <h3>List of Sections:</h3>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Section</th>
        <th>Room</th>
        <th>Timeslot</th>
      </tr>
    </thead>    
    <tbody>
      <% @student.classlists.each do |classlist| %>
        <tr>
          <td><%= classlist.section.subject&.name %></td>
          <td><%= classlist.section&.name %></td>
          <td><%= classlist.section&.room %></td>
          <td><%= classlist.section&.timeslot %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

<% else %>
  <p>Not enrolled in any sections yet.</p>
<% end %>

<div>
  <%= link_to "Edit this student", edit_student_path(@student) %> |
  <%= link_to "Back to students", students_path %>

  <%= button_to "Destroy this student", @student, method: :delete %>
</div>
