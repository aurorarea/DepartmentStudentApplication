<% content_for :title, @student.name %>

<% if notice.present? %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= notice %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>

<!-- Top Header with Actions -->
<div class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <h1 class="h2 mb-1 fw-bold"><%= @student.name %></h1>
    <p class="text-muted mb-0"><%= @student.program %> &bull; Year <%= @student.year_level %></p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Edit", edit_student_path(@student), class: "btn btn-secondary" %>
    <%= link_to "Back to Students", students_path, class: "btn btn-outline-secondary" %>
    <%= button_to "Delete", @student, method: :delete, class: "btn btn-danger", data: { turbo_confirm: "Are you sure?" } %>
  </div>
</div>

<!-- Details & Summary Section -->
<div class="row g-4 mb-4">
  <!-- Student Details Card -->
  <div class="col-md-6">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-header bg-light py-3">
        <h6 class="card-title mb-0 fw-bold text-secondary">Student Details</h6>
      </div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-5 text-muted fw-normal mb-2">Name</dt>
          <dd class="col-7 fw-semibold mb-2"><%= @student.name %></dd>

          <dt class="col-5 text-muted fw-normal mb-2">Year Level</dt>
          <dd class="col-7 mb-2"><%= @student.year_level %></dd>

          <dt class="col-5 text-muted fw-normal mb-2">Program</dt>
          <dd class="col-7 mb-2"><%= @student.program %></dd>

          <dt class="col-5 text-muted fw-normal mb-2">Department</dt>
          <dd class="col-7 mb-0"><%= @student.department&.name || "N/A" %></dd>
        </dl>
      </div>
    </div>
  </div>

  <!-- Enrollment Summary Card -->
  <div class="col-md-6">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-header bg-light py-3">
        <h6 class="card-title mb-0 fw-bold text-secondary">Enrollment Summary</h6>
      </div>
      <div class="card-body d-flex align-items-center justify-content-around text-center">
        <div>
          <div class="display-6 fw-bold text-dark"><%= @student.subjectsCount || @student.classlists.count %></div>
          <small class="text-muted fw-semibold">Subjects</small>
        </div>
        <div class="vr my-2"></div>
        <div>
          <div class="display-6 fw-bold text-dark"><%= @student.numberOfUnits || 0 %></div>
          <small class="text-muted fw-semibold">Units</small>
        </div>
        <div class="vr my-2"></div>
        <div>
          <div class="display-6 fw-bold text-dark"><%= number_to_currency(@student.tuitionFee || 0, unit: "₱") %></div>
          <small class="text-muted fw-semibold">Tuition Fee</small>
        </div>
      </div>
    </div>
  </div>
</div>

