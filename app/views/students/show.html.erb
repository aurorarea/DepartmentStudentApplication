<!-- Enroll in a Section Card -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-light py-3">
    <h6 class="card-title mb-0 fw-bold text-secondary">Enroll in a Section</h6>
  </div>
  <div class="card-body">
    <%= form_with(model: @classlist, local: true) do |form| %>
      <%= form.hidden_field :student_id, value: @student.id %>
      <%= hidden_field_tag :from_student, @student.id %>

      <div class="mb-3">
        <%= form.label :section_id, "Section", class: "form-label fw-semibold" %>
        <%= form.collection_select :section_id, @available_sections || Section.all, :id, ->(s) { s.respond_to?(:display_name) ? s.display_name : "#{s.subject&.name} - #{s.name}" }, { prompt: "Select a section" }, { class: "form-select" } %>
      </div>

      <div class="text-end">
        <%= form.submit "Enroll", class: "btn btn-primary px-4" %>
      </div>
    <% end %>
  </div>
</div>
</div>