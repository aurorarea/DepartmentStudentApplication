 
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 pb-2">
    <div>
      <h1 class="display-5 fw-extrabold text-dark tracking-tight mb-1" style="font-weight: 800; color: #0f172a;">
        Dashboard
      </h1>
      <p class="fs-5 mb-0" style="color: #64748b; font-weight: 400;">
        Explore the people, programs and academic structure of the Department
      </p>
    </div>

    <div class="d-flex align-items-center gap-2">
      <%= link_to students_path, class: "glossy-search-pill text-decoration-none d-flex align-items-center px-3 py-2" do %>
        <i class="bi bi-people-fill me-2 text-white-50"></i>
        <span class="search-text text-white fw-medium small">Browse Students</span>
      <% end %>

      <%= link_to teachers_path, class: "glossy-search-pill text-decoration-none d-flex align-items-center px-3 py-2" do %>
        <i class="bi bi-person-badge-fill me-2 text-white-50"></i>
        <span class="search-text text-white fw-medium small">Browse Teachers</span>
      <% end %>
    </div>
  </div>

  <div class="p-4 mb-20">
  </div>

  <!-- Dashboards counts -->
  <div class="row g-3 mb-5">
  <!-- Students Card -->
  <div class="col-sm-6 col-xl-3">
    <div class="card metric-pill bg-gradient-students text-white shadow-sm p-3">
      <div class="d-flex align-items-center">
        <div class="icon-circle me-3">
          <i class="bi bi-people-fill fs-4 text-success"></i>
        </div>
        <div>
          <div class="text-uppercase fw-semibold small opacity-75" style="letter-spacing: 0.5px;">Students</div>
          <div class="fs-2 fw-bold leading-tight"><%= @student_count %></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Teachers Card -->
  <div class="col-sm-6 col-xl-3">
    <div class="card metric-pill bg-gradient-teachers text-white shadow-sm p-3">
      <div class="d-flex align-items-center">
        <div class="icon-circle me-3">
          <i class="bi bi-person-badge-fill fs-4 text-primary"></i>
        </div>
        <div>
          <div class="text-uppercase fw-semibold small opacity-75" style="letter-spacing: 0.5px;">Teachers</div>
          <div class="fs-2 fw-bold leading-tight"><%= @teacher_count %></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Departments Card -->
  <div class="col-sm-6 col-xl-3">
    <div class="card metric-pill bg-gradient-departments text-white shadow-sm p-3">
      <div class="d-flex align-items-center">
        <div class="icon-circle me-3">
          <i class="bi bi-building-fill fs-4 text-danger"></i>
        </div>
        <div>
          <div class="text-uppercase fw-semibold small opacity-75" style="letter-spacing: 0.5px;">Departments</div>
          <div class="fs-2 fw-bold leading-tight"><%= @department_count %></div>
        </div>
      </div>
    </div>

  <!-- Subjects Card -->
  <div class="col-sm-6 col-xl-3">
    <div class="card metric-pill bg-gradient-subjects text-white shadow-sm p-3">
      <div class="d-flex align-items-center">
        <div class="icon-circle me-3">
          <i class="bi bi-journal-bookmark-fill fs-4 text-warning"></i>
        </div>
        <div>
          <div class="text-uppercase fw-semibold small opacity-75" style="letter-spacing: 0.5px;">Subjects</div>
          <div class="fs-2 fw-bold leading-tight"><%= @subject_count %></div>
        </div>
      </div>
    </div>
  </div>
</div>

  <div class="p-4 mb-40">
  </div>

  <!-- Main Content Split Grid -->
  <div class="row g-4 flex-fill">
    <!-- Left Column: Explore Directory Cards -->
    <div class="col-lg-8 d-flex flex-column">
      <h2 class="display-6 fw-bold mb-3 section-title">Explore the Directory</h2>
      <div class="row g-4 flex-fill">
        <div class="col-sm-6 d-flex">
          <div class="card border-0 shadow-sm w-100 flex-fill bg-white border-top border-primary border-4">
            <div class="card-body d-flex flex-column justify-content-between p-4">
              <div>
                <h3 class="card-title display-6 fw-bold mb-3 text-primary">Departments</h3>
                <p class="card-text text-muted fs-5 mb-0">Offices and locations.</p>
              </div>
              <div class="d-flex gap-3 mt-4">
                <%= link_to "View all", departments_path, class: "btn btn-primary btn-lg px-4 fs-5 shadow-sm" %>
                <%= link_to "Add new", new_department_path, class: "btn btn-outline-primary btn-lg px-4 fs-5" %>
              </div>
            </div>
          </div>
        </div>

        <div class="col-sm-6 d-flex">
          <div class="card border-0 shadow-sm w-100 flex-fill bg-white border-top border-info border-4">
            <div class="card-body d-flex flex-column justify-content-between p-4">
              <div>
                <h3 class="card-title display-6 fw-bold mb-3 text-info">Students</h3>
                <p class="card-text text-muted fs-5 mb-0">Enrolled students list.</p>
              </div>
              <div class="d-flex gap-3 mt-4">
                <%= link_to "View all", students_path, class: "btn btn-info btn-lg px-4 fs-5 text-white shadow-sm" %>
                <%= link_to "Add new", new_student_path, class: "btn btn-outline-info btn-lg px-4 fs-5" %>
              </div>
            </div>
          </div>
        </div>

        <div class="col-sm-6 d-flex">
          <div class="card border-0 shadow-sm w-100 flex-fill bg-white border-top border-warning border-4">
            <div class="card-body d-flex flex-column justify-content-between p-4">
              <div>
                <h3 class="card-title display-6 fw-bold mb-3 text-dark">Teachers</h3>
                <p class="card-text text-muted fs-5 mb-0">Faculty and courses.</p>
              </div>
              <div class="d-flex gap-3 mt-4">
                <%= link_to "View all", teachers_path, class: "btn btn-warning btn-lg px-4 fs-5 text-dark fw-bold shadow-sm" %>
                <%= link_to "Add new", new_teacher_path, class: "btn btn-outline-warning btn-lg px-4 fs-5 text-dark" %>
              </div>
            </div>
          </div>
        </div>

        <div class="col-sm-6 d-flex">
          <div class="card border-0 shadow-sm w-100 flex-fill bg-white border-top border-success border-4">
            <div class="card-body d-flex flex-column justify-content-between p-4">
              <div>
                <h3 class="card-title display-6 fw-bold mb-3 text-success">Subjects</h3>
                <p class="card-text text-muted fs-5 mb-0">Curriculum and subjects.</p>
              </div>
              <div class="d-flex gap-3 mt-4">
                <%= link_to "View all", subjects_path, class: "btn btn-success btn-lg px-4 fs-5 text-white shadow-sm" %>
                <%= link_to "Add new", new_subject_path, class: "btn btn-outline-success btn-lg px-4 fs-5" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Meet Our Faculty -->
    <div class="col-lg-4 d-flex flex-column">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="display-6 fw-bold mb-0 section-title">Meet Our Faculty</h2>
        <%= link_to teachers_path, class: "btn btn-sm btn-outline-primary rounded-pill px-3 py-1 d-inline-flex align-items-center gap-1 fw-semibold text-decoration-none" do %>
          <span>See all</span>
          <i class="bi bi-arrow-right"></i>
        <% end %>
      </div>

      <div class="card border-0 shadow-sm flex-fill w-100 bg-white border-top border-dark border-4">
        <div class="card-body d-flex flex-column justify-content-between p-4 h-100">
          <div class="list-group list-group-flush w-100 flex-fill d-flex flex-column justify-content-around">
            <% @teachers.each do |teacher| %>
              <div class="list-group-item px-0 py-4 d-flex align-items-center justify-content-between bg-transparent border-bottom">
                <div class="d-flex align-items-center gap-4">
                  <% avatar_files = ["images (1).jpeg", "images (2).jpeg", "images (3).jpeg", "images (4).jpeg", "images (5).jpeg", "images (6).jpeg", "images.png", "images (7).jpeg"] %>
                  <% assigned_avatar = avatar_files[teacher.id % avatar_files.length] %>
                  <%= image_tag assigned_avatar, alt: teacher.name, width: 80, height: 80, class: "rounded-circle object-fit-cover shadow border border-2 border-primary" %>
                  <div>
                    <h4 class="mb-1 fw-bold text-dark"><%= teacher.name %></h4>
                    <span class="text-muted fs-5"><%= teacher.specialization %></span>
                  </div>
                </div>
                <div>
                  <%= link_to "Profile", teacher, class: "btn btn-outline-primary btn-lg px-4 fs-5 shadow-sm" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>