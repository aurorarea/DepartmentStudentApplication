<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Departments</h1>
  <%= link_to "New department", new_department_path, class: "btn btn-primary" %>
</div>

<!-- Same Row: Search Bar + Export Excel -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <!-- Search Form -->
  <div class="w-25">
    <%= search_form_for @q, url: departments_path, method: :get, class: "d-flex  gap-2" do |f| %>
      <div class="input-group input-group-sm">
       <%= f.search_field :name_cont, class: "form-control form-control-sm", placeholder: "Search department by name..." %>
        <button type="submit" class="btn text-white btn-sm px-3" style="background-color: #15370D;">
          <i class="bi bi-search"></i>
        </button>
      </div>

      <% if params[:q].present? %>
        <%= link_to "Clear", departments_path, class: "btn btn-outline-secondary btn-sm" %>
      <% end %>
    <% end %>
  </div>

  <%= link_to departments_path(q: params[:q]&.to_unsafe_h, format: :xlsx), class: "btn btn-outline-success btn-sm d-inline-flex align-items-center gap-1" do %>
  <i class="bi bi-file-earmark-excel"></i> Export Excel
  <% end %>
</div>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle border">
    <thead class="table-dark">
      <tr>
        <th>Name</th>
        <th>Location</th>
        <th>Students Count</th>
        <th>Teachers Count</th>
        <th>Laboratory</th>
        <th class="text-center">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @departments.each do |department| %>
        <%= render department %>
      <% end %>
    </tbody>
  </table>
  <div class="table-responsive">
  <table class="table">
  </table>
</div>

<div class="d-flex justify-content-center mt-4">
  <%= @pagy.series_nav(:bootstrap).html_safe %>
</div>
</div>
