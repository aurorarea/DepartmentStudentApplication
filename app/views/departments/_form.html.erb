<%= form_with(model: department, class: "needs-validation") do |form| %>
  <% if department.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <h4 class="alert-heading"><%= pluralize(department.errors.count, "error") %> prohibited this department from being saved:</h4>
      <ul>
        <% department.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label fw-bold" %>
    <%= form.text_field :name, class: "form-control shadow-sm" %>
  </div>

  <div class="mb-3">
    <%= form.label :location, class: "form-label fw-bold" %>
    <%= form.text_field :location, class: "form-control shadow-sm" %>
  </div>

  <div class="d-flex align-items-center mt-4">
    <%= form.submit class: "btn btn-info text-white rounded-pill px-4 shadow-sm" %>
    <%= link_to "✕ Back to departments", departments_path, class: "btn btn-outline-danger rounded-pill px-4 ms-2" %>
  </div>
<% end %>