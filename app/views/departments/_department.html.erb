<tr id="<%= dom_id department %>">
  <td><strong><%= department.name %></strong></td>
  <td><%= department.location %></td>
  <td><%= department.studentsCount || 0 %></td>
  <td><%= department.teachersCount || 0 %></td>
  <td><%= department.laboratory %></td>
  <td class="text-center">
    <div class="btn-group btn-group-sm" role="group">
      <%= link_to "Show", department, class: "btn btn-outline-info" %>
      <%= link_to "Edit", edit_department_path(department), class: "btn btn-outline-warning" %>
      <%= button_to "Destroy", department, method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-outline-danger" %>
    </div>
  </td>
</tr>