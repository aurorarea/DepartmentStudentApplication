<div class="container mt-4">
  <% if notice.present? %>
    <p class="alert alert-success" role="alert"><%= notice %></p>
  <% end %>

  <div class="mb-4">
    <%= render @teacher %>
  </div>

  <div class="d-flex gap-2">
    <%= link_to "Edit this teacher", edit_teacher_path(@teacher), class: "btn btn-warning" %>
    <%= link_to "Back to teachers", teachers_path, class: "btn btn-secondary" %>
    <%= button_to "Destroy this teacher", @teacher, method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-danger" %>
  </div>
</div>