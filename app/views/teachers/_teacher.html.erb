<tr id="<%= dom_id teacher %>">
  <td><strong><%= teacher.name %></strong></td>
  <td><%= teacher.email %></td>
  <td><%= teacher.specialization %></td>
  <td><%= teacher.department&.name %></td>
  <td><%= number_to_currency(teacher.monthlySalary || 0, unit: "₱") %></td>
  <td><%= number_to_currency(teacher.perUnitRate || 0, unit: "₱") %></td>
  <td class="text-center">
    <div class="btn-group btn-group-sm" role="group">
      <%= link_to "Show", teacher, class: "btn btn-outline-info" %>
      <%= link_to "Edit", edit_teacher_path(teacher), class: "btn btn-outline-warning" %>
      <%= button_to "Destroy", teacher, method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-outline-danger" %>
    </div>
  </td>
</tr>