<div id="<%= dom_id teacher %>">
  <div>
    <strong>Name:</strong>
    <%= teacher.name %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= teacher.email %>
  </div>

  <div>
    <strong>Specialization:</strong>
    <%= teacher.specialization %>
  </div>

  <div>
    <strong>Department:</strong>
    <%= teacher.department&.name %>
  </div>

  <div>
    <strong>Monthly Salary:</strong>
    <%= teacher.monthlySalary %>
  </div>

  <div>
    <strong>Per Unit Rate:</strong>
    <%= teacher.perUnitRate%>
  </div>

</div>
