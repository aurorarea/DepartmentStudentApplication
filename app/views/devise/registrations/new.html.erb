<div class="container d-flex justify-content-center align-items-center min-vh-100">
  <div class="col-md-5">
    <!-- Card matching your dashboard styling -->
    <div class="card shadow-sm border-0 p-4 rounded-4" style="background-color: #ffffff;">
      <div class="card-body">
        
        <div class="text-center mb-4">
          <span class="badge bg-success px-3 py-2 mb-2 rounded-pill">Portal Registration</span>
          <h3 class="fw-bold text-dark">Create an Account</h3>
          <p class="text-muted small">Register to access the Department App</p>
        </div>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="mb-3">
            <%= f.label :email, class: "form-label fw-semibold text-secondary small" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control rounded-pill px-3 py-2", placeholder: "name@example.com" %>
          </div>

          <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center">
              <%= f.label :password, class: "form-label fw-semibold text-secondary small mb-1" %>
              <% if @minimum_password_length %>
                <span class="text-muted" style="font-size: 0.75rem;">(<%= @minimum_password_length %> characters minimum)</span>
              <% end %>
            </div>
            <div class="input-group">
              <%= f.password_field :password, autocomplete: "new-password", class: "form-control rounded-start-pill px-3 py-2", placeholder: "••••••••", id: "signup-password" %>
              <button class="btn btn-outline-secondary rounded-end-pill px-3" type="button" onclick="togglePassword('signup-password', this)">
                Show
              </button>
            </div>
          </div>

          <div class="mb-4">
            <%= f.label :password_confirmation, class: "form-label fw-semibold text-secondary small" %>
            <div class="input-group">
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control rounded-start-pill px-3 py-2", placeholder: "••••••••", id: "signup-password-confirm" %>
              <button class="btn btn-outline-secondary rounded-end-pill px-3" type="button" onclick="togglePassword('signup-password-confirm', this)">
                Show
              </button>
            </div>
          </div>

          <div class="d-grid mb-3">
            <%= f.submit "Sign up", class: "btn btn-success rounded-pill py-2 fw-bold shadow-sm" %>
          </div>
        <% end %>

        <div class="text-center mt-3">
          <%= render "devise/shared/links" %>
        </div>

      </div>
    </div>
  </div>
</div>
