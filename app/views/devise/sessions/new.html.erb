<div class="container d-flex justify-content-center align-items-center min-vh-100">
  <div class="col-md-5">
    <!-- Card matching your dashboard styling -->
    <div class="card shadow-sm border-0 p-4 rounded-4" style="background-color: #ffffff;">
      <div class="card-body">
        
        <div class="text-center mb-4">
          <span class="badge bg-success px-3 py-2 mb-2 rounded-pill">Portal Access</span>
          <h3 class="fw-bold text-dark">Log in to Department App</h3>
          <p class="text-muted small">Enter your credentials to access your dashboard</p>
        </div>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
          <div class="mb-3">
            <%= f.label :email, class: "form-label fw-semibold text-secondary small" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control rounded-pill px-3 py-2", placeholder: "name@example.com" %>
          </div>

          <div class="mb-3">
            <%= f.label :password, class: "form-label fw-semibold text-secondary small" %>
            <div class="input-group">
              <%= f.password_field :password, autocomplete: "current-password", class: "form-control rounded-start-pill px-3 py-2", placeholder: "••••••••", id: "login-password" %>
              <button class="btn btn-outline-secondary rounded-end-pill px-3" type="button" onclick="togglePassword('login-password', this)">
                Show
              </button>
            </div>
          </div>
          
          <% if devise_mapping.rememberable? %>
            <div class="mb-3 form-check">
              <%= f.check_box :remember_me, class: "form-check-input" %>
              <%= f.label :remember_me, class: "form-check-label small text-muted" %>
            </div>
          <% end %>

          <div class="d-grid mb-3">
            <%= f.submit "Log in", class: "btn btn-success rounded-pill py-2 fw-bold shadow-sm" %>
          </div>
        <% end %>

        <div class="text-center mt-3">
          <%= render "devise/shared/links" %>
        </div>

      </div>
    </div>
  </div>
</div>