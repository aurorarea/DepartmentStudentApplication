<%= form_with(model: classlist, class: "needs-validation") do |form| %>
  <% if classlist.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <h4 class="alert-heading"><%= pluralize(classlist.errors.count, "error") %> prohibited this classlist from being saved:</h4>
      <ul>
        <% classlist.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :student_id, class: "form-label fw-bold" %>
    <%= form.collection_select :student_id, Student.all, :id, :name, { prompt: "Select a student" }, { class: "form-select shadow-sm" } %>
  </div>

  <div class="mb-3">
    <%= form.label :section_id, class: "form-label fw-bold" %>
    <%= form.collection_select :section_id, Section.all, :id, :name, { prompt: "Select a section" }, { class: "form-select shadow-sm" } %>
  </div>

  <div class="d-flex align-items-center mt-4">
    <%= form.submit class: "btn btn-info text-white rounded-pill px-4 shadow-sm" %>
    <%= link_to "✕ Back to classlists", classlists_path, class: "btn btn-outline-danger rounded-pill px-4 ms-2" %>
  </div>
<% end %>