<% content_for :title, "Classlist" %>

<div class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <h1 class="h2 mb-1 fw-bold">Classlist Management</h1>
    <p class="text-muted mb-0">Students grouped under their respective sections</p>
  </div>
</div>

<!-- Sections loop with students nested under each -->
<% if @sections.any? %>
  <% @sections.each do |section| %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
        <div>
          <h5 class="card-title mb-0 fw-bold text-dark">Section: <%= section.name %></h5>
          <small class="text-muted">Room: <%= section.room %> | Timeslot: <%= section.timeslot %></small>
        </div>
        <span class="badge bg-secondary rounded-pill"><%= section.students.count rescue 0 %> Students</span>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-4">Student Name</th>
                <th>Program</th>
                <th>Year Level</th>
                <th class="text-end pe-4">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if section.students.any? %>
                <% section.students.each do |student| %>
                  <tr>
                    <td class="ps-4 fw-semibold"><%= student.name %></td>
                    <td><%= student.program %></td>
                    <td><%= student.year_level %></td>
                    <td class="text-end pe-4">
                      <%= link_to "Show", student_path(student), class: "btn btn-sm btn-outline-primary" %>
                    </td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="4" class="text-center py-3 text-muted">No students listed under this section.</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>
<% else %>
  <div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5 text-muted">
      No sections found in the classlist.
    </div>
  </div>
<% end %>
