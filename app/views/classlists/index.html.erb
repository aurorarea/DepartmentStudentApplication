<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Class Lists</h1>
  <%= link_to "New classlist", new_classlist_path, class: "btn btn-primary" %>
</div>

  <!-- Search Form -->
<div class="mb-3 w-25" style="min-width: 250px;">
  <%= search_form_for @q, url: classlists_path, method: :get, class: "d-flex gap-2" do |f| %>
    <div class="input-group input-group-sm">
      <%= f.search_field :student_name_or_section_name_or_section_subject_name_cont, class: "form-control form-control-sm", placeholder: "Search classlist by student/subject/section name..." %>
      <button type="submit" class="btn text-white btn-sm px-3" style="background-color: #15370D;">
        <i class="bi bi-search"></i>
      </button>
    </div>
    
    <% if params[:q].present? %>
      <%= link_to "Clear", classlists_path, class: "btn btn-outline-secondary btn-sm" %>
    <% end %>
  <% end %>
</div>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle border">
    <thead class="table-dark">
      <tr>
        <th>Student</th>
        <th>Section</th>
        <th>Subject</th>
        <th class="text-center">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @classlists.each do |classlist| %>
        <%= render classlist %>
      <% end %>
    </tbody>
  </table>
  <div class="table-responsive">
  <table class="table">
  </table>
</div>

<div class="d-flex justify-content-center mt-4">
  <%= @pagy.series_nav(:bootstrap).html_safe %>
</div>
</div>