<!DOCTYPE html>
<html>
<head>
  <title><%= content_for(:title) || "Department Student Application" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- Bootstrap 5 CSS CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>

<body>
  <!-- Top Bar with ONLY the Hamburger Toggle Button -->
  <nav class="navbar navbar-dark bg-dark fixed-top shadow-sm">
    <div class="container-fluid justify-content-end">
      <!-- Toggle button that opens the offcanvas sidebar -->
      <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasSidebar" aria-controls="offcanvasSidebar" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
    </div>
  </nav>

 <!-- Toggleable Offcanvas Sidebar (Slides from Left) -->
  <div class="offcanvas offcanvas-start text-bg-dark" tabindex="-1" id="offcanvasSidebar" aria-labelledby="offcanvasSidebarLabel">
    <div class="offcanvas-header">
      <!-- "Department Student App" title moved here inside the sidebar -->
      <h5 class="offcanvas-title" id="offcanvasSidebarLabel">
        <%= link_to "Department Student App", students_path, class: "text-white text-decoration-none fw-bold fs-5" %>
      </h5>
      <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
      <ul class="nav flex-column px-2">
        <li class="nav-item mb-1">
          <%= link_to "Students", students_path, class: "nav-link text-white rounded #{'active bg-primary' if current_page?(students_path)}" %>
        </li>
        <li class="nav-item mb-1">
          <%= link_to "Departments", departments_path, class: "nav-link text-white rounded #{'active bg-primary' if current_page?(departments_path)}" %>
        </li>
        <li class="nav-item mb-1">
          <%= link_to "Teachers", teachers_path, class: "nav-link text-white rounded #{'active bg-primary' if current_page?(teachers_path)}" %>
        </li>
        <li class="nav-item mb-1">
          <%= link_to "Subjects", subjects_path, class: "nav-link text-white rounded #{'active bg-primary' if current_page?(subjects_path)}" %>
        </li>
        <li class="nav-item mb-1">
          <%= link_to "Sections", sections_path, class: "nav-link text-white rounded #{'active bg-primary' if current_page?(sections_path)}" %>
        </li>
        <li class="nav-item mb-1">
          <%= link_to "Class Lists", classlists_path, class: "nav-link text-white rounded #{'active bg-primary' if current_page?(classlists_path)}" %>
        </li>
      </ul>
    </div>
  </div>

  <!-- Main Content Area -->
  <main class="container py-5 mt-4">
    <%= yield %>
  </main>

  <!-- Bootstrap 5 JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>