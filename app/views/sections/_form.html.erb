<%= form_with(model: section, class: "needs-validation") do |form| %>
  <% if section.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <h4 class="alert-heading"><%= pluralize(section.errors.count, "error") %> prohibited this section from being saved:</h4>
      <ul>
        <% section.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label fw-bold" %>
    <%= form.text_field :name, class: "form-control shadow-sm" %>
  </div>

  <div class="mb-3">
    <%= form.label :room, class: "form-label fw-bold" %>
    <%= form.text_field :room, class: "form-control shadow-sm" %>
  </div>

  <div class="mb-3">
    <%= form.label :timeslot, class: "form-label fw-bold" %>
    <%= form.text_field :timeslot, class: "form-control shadow-sm" %>
  </div>

  <div class="mb-3">
    <%= form.label :subject_id, class: "form-label fw-bold" %>
    <%= form.collection_select :subject_id, Subject.all, :id, :name, { prompt: "Select a subject" }, { class: "form-select shadow-sm" } %>
  </div>

  <div class="d-flex align-items-center mt-4">
    <%= form.submit class: "btn btn-info text-white rounded-pill px-4 shadow-sm" %>
    <%= link_to "✕ Back to sections", sections_path, class: "btn btn-outline-danger rounded-pill px-4 ms-2" %>
  </div>
<% end %>