<% content_for :title, @section.name %>

<div class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <h1 class="h2 mb-1 fw-bold"><%= @section.name %></h1>
    <p class="text-muted mb-0">Room: <%= @section.room %> | Timeslot: <%= @section.timeslot %></p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Edit", edit_section_path(@section), class: "btn btn-secondary" %>
    <%= link_to "Back to Sections", sections_path, class: "btn btn-outline-secondary" %>
  </div>
</div>

<!-- Section Details & Students List -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
    <h6 class="card-title mb-0 fw-bold text-secondary">Enrolled Students</h6>
    <span class="badge bg-secondary rounded-pill"><%= @section.students.count rescue @section.studentsCount %></span>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-4">Student Name</th>
            <th>Program</th>
            <th>Year Level</th>
            <th class="text-end pe-4">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @section.students.any? %>
            <% @section.students.each do |student| %>
              <tr>
                <td class="ps-4 fw-semibold"><%= student.name %></td>
                <td><%= student.program %></td>
                <td><%= student.year_level %></td>
                <td class="text-end pe-4">
                  <%= link_to "Show", student_path(student), class: "btn btn-sm btn-outline-primary" %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="text-center py-4 text-muted">No students enrolled in this section.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Change History Section -->
<div class="card shadow-sm mb-4">
  <div class="card-body">
    <h5 class="card-title mb-3">Change History</h5>
    
    <% if @section.versions.any? %>
      <% @section.versions.order(created_at: :desc).each do |version| %>
        <div class="d-flex align-items-start mb-3 pb-3 border-bottom">
          <div class="me-3">
            <% badge_class = case version.event
               when 'create' then 'bg-success'
               when 'update' then 'bg-primary'
               when 'destroy' then 'bg-danger'
               else 'bg-secondary'
               end %>
            <span class="badge <%= badge_class %> text-uppercase"><%= version.event %></span>
          </div>
          
          <div class="flex-grow-1">
            <div class="text-muted small mb-1">
              <%= version.created_at.strftime("%B %d, %Y at %I:%M %p") %>
            </div>
            
            <% if version.changeset.present? %>
              <ul class="list-unstyled mb-0 small">
                <% version.changeset.each do |attribute, (old_val, new_val)| %>
                  <li>
                    <strong><%= attribute.humanize %>:</strong> 
                    <em><%= old_val.inspect %></em> &rarr; <em><%= new_val.inspect %></em>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <p class="text-muted small mb-0">Record created.</p>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-muted mb-0">No changes recorded yet.</p>
    <% end %>
  </div>
</div>