<div class="container mt-4">
  <% if notice.present? %>
    <p class="alert alert-success" role="alert"><%= notice %></p>
  <% end %>

  <% content_for :title, "Subjects" %>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0">Subjects</h1>
    <%= link_to "New subject", new_subject_path, class: "btn btn-primary" %>
  </div>
  
  <!-- Search Form -->
  <div class="mb-3 w-25">
    <%= search_form_for @q, url: subjects_path, method: :get, class: "d-flex  gap-2" do |f| %>
      <div class="input-group input-group-sm">
        <%= f.search_field :name_cont, class: "form-control form-control-sm", placeholder: "Search subject by name..." %>
        <button type="submit" class="btn text-white btn-sm px-3" style="background-color: #15370D;">
          <i class="bi bi-search"></i>
        </button>
      </div>
      
      <% if params[:q].present? %>
        <%= link_to "Clear", subjects_path, class: "btn btn-outline-secondary btn-sm" %>
      <% end %>
    <% end %>
  </div>
  
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle shadow-sm border">
      <thead class="table-dark">
        <tr>
          <th>Name</th>
          <th>Teacher</th>
          <th>Section Count</th>
          <th class="text-center">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @subjects.each do |subject| %>
          <tr>
            <td class="fw-semibold"><%= subject.name %></td>
            <td><%= subject.teacher&.name || "Unassigned" %></td>
            <td><%= subject.sectionCount || 0 %></td>
            <td class="text-center">
              <%= link_to "Show", subject, class: "btn btn-sm btn-outline-info me-1" %>
              <%= link_to "Edit", edit_subject_path(subject), class: "btn btn-sm btn-outline-warning me-1" %>
              <%= button_to "Destroy", subject, method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-sm btn-outline-danger d-inline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <div class="table-responsive">
  <table class="table">
  </table>
</div>

<div class="d-flex justify-content-center mt-4">
  <%= @pagy.series_nav(:bootstrap).html_safe %>
</div>
  </div>
</div>