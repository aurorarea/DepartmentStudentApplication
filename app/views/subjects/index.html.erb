<div class="container mt-4">
  <% if notice.present? %>
    <p class="alert alert-success" role="alert"><%= notice %></p>
  <% end %>

  <% content_for :title, "Subjects" %>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0">Subjects</h1>
    <%= link_to "New subject", new_subject_path, class: "btn btn-primary" %>
  </div>

  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle shadow-sm border">
      <thead class="table-dark">
        <tr>
          <th>Name</th>
          <th>Teacher</th>
          <th>Section Count</th>
          <th class="text-center">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @subjects.each do |subject| %>
          <tr>
            <td class="fw-semibold"><%= subject.name %></td>
            <td><%= subject.teacher&.name || "Unassigned" %></td>
            <td><%= subject.sectionCount || 0 %></td>
            <td class="text-center">
              <%= link_to "Show", subject, class: "btn btn-sm btn-outline-info me-1" %>
              <%= link_to "Edit", edit_subject_path(subject), class: "btn btn-sm btn-outline-warning me-1" %>
              <%= button_to "Destroy", subject, method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-sm btn-outline-danger d-inline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>