<tr id="<%= dom_id subject %>">
  <td><strong><%= subject.name %></strong></td>
  <td><%= subject.teacher&.name %></td>
  <td><%= subject.sectionsCount || subject.sections.count %></td>
  <td class="text-center">
    <div class="btn-group btn-group-sm" role="group">
      <%= link_to "Show", subject, class: "btn btn-outline-info" %>
      <%= link_to "Edit", edit_subject_path(subject), class: "btn btn-outline-warning" %>
<%= button_to "Destroy", subject, method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-outline-danger", form_class: "d-inline" %>   
   </div>
  </td>
</tr>