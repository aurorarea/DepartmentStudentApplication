<p>
  <strong>Name:</strong> <%= @subject.name %><br>
  <strong>Teacher:</strong> <%= @subject.teacher&.name %>
</p>

<h3>Sections</h3>

<% @subject.sections.each do |section| %>
  <p>
    <strong><%= section.name %></strong></p>
    Room: <%= section.room %> | Timeslot: <%= section.timeslot %> | Teacher: <%= @subject.teacher&.name %>
  </p>

  <% if section.classlists.any? %>
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Year Level</th>
          <th>Program</th>
        </tr>
      </thead>
      <tbody>
        <% section.classlists.each do |classlist| %>
          <tr>
            <td><%= classlist.student&.name %></td>
            <td><%= classlist.student&.year_level %></td>
            <td><%= classlist.student&.program %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No students enrolled in this section.</p>
  <% end %>
<% end %>

<div>
  <%= link_to "Edit this subject", edit_subject_path(@subject) %> |
  <%= link_to "Back to subjects", subjects_path %>
</div>