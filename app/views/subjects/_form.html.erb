<%= form_with(model: subject, class: "needs-validation") do |form| %>
  <% if subject.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <h4 class="alert-heading"><%= pluralize(subject.errors.count, "error") %> prohibited this subject from being saved:</h4>
      <ul>
        <% subject.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label fw-bold" %>
    <%= form.text_field :name, class: "form-control shadow-sm" %>
  </div>

  <div class="mb-3">
    <%= form.label :teacher_id, class: "form-label fw-bold" %>
    <%= form.collection_select :teacher_id, Teacher.all, :id, :name, { prompt: "Select a teacher" }, { class: "form-select shadow-sm" } %>
  </div>

  <div class="d-flex align-items-center mt-4">
    <%= form.submit class: "btn btn-info text-white rounded-pill px-4 shadow-sm" %>
    <%= link_to "✕ Back to subjects", subjects_path, class: "btn btn-outline-danger rounded-pill px-4 ms-2" %>
  </div>
<% end %>